      "parameters": {
        "method": "POST",
        "url": "http://stirling-pdf-b8o0g8gwg0okkoos0oo48kcg:8080/api/v1/misc/ocr-pdf",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "fileInput",
              "inputDataFieldName": "data"
            },
            {
              "name": "ocrType",
              "value": "ocr-only"
            },
            {
              "name": "languages",
              "value": "spa"
            }
          ]
        },
        "options": {}
      },
      "id": "4b96c291-1811-4f3e-b64e-a8b6e2b2cdac",
      "name": "Stirling-PDF OCR",
      "type": "n8n-nodes-base.httpRequest",
