        "httpHeaderAuth": {
          "id": "uz6EzICWKdyW6bYM",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1. Inicializar el texto\nlet final_text = '';\n// 2. Intentar obtener el texto del nodo IF (camino de extracci\u00f3n normal)\ntry {\n  final_text = $input.first().json.text\n} catch (e) {\n  // Si falla (porque venimos por el camino del OCR), intentamos el otro\n  try {\n    final_text = $('Stirling-PDF OCR').$input.first().json.text\n  } catch (err) {\n    final_text = '';\n  }\n}\n// 3. Obtener los datos del Webhook (Aseg\u00farate de que se llame Webhook1)\nconst webhookBody = $('Webhook1').first().json.body\n// 4. Devolver el resultado limpio\nreturn {\n  texto: final_text ? final_text.replace(/\\s+/g, ' ').trim() : \"\",\n  documento_id: webhookBody.documento_id,\n  callback_url: webhookBody.callback_url\n};"
      },
      "id": "15fa0584-10f9-4fcb-8339-c4d1a817c071",
