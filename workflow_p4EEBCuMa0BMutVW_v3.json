      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE documentos_documento\nSET \n  contenido_texto = '{{ $json.texto.replaceAll(\"'\", \"''\") }}',\n  actualizado_en = NOW()\nWHERE\n  id = {{ $json.documento_id }};\n",
