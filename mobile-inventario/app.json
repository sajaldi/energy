{
  "expo": {
    "name": "SoftCoM Inventario",
    "slug": "softcom-inventario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#354a5f"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#354a5f"
      },
      "package": "hn.ccg.softcom.inventario",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Se necesita la cámara para escanear códigos QR y de barras."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#0070f2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c74b5e10-21d7-44cc-be7d-cc965346c727"
      }
    },
    "owner": "sajaldi",
    "ios": {
      "bundleIdentifier": "hn.ccg.softcom.inventario",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
