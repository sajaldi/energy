{
  "expo": {
    "name": "SoftCoM Inventario",
    "slug": "softcom-inventario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#354a5f"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#354a5f"
      },
      "package": "hn.ccg.softcom.inventario",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Se necesita la cámara para escanear códigos QR y de barras." }]
    ]
  }
}
